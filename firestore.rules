rules_version = '2';

// Regras usadas apenas pelo emulador local do Firestore, para testar o
// chatbot na sua máquina. NÃO são publicadas automaticamente: só valem na
// nuvem se você rodar "firebase deploy --only firestore" de propósito.
// Se o projeto já tem regras configuradas no Console do Firebase, elas
// continuam intactas até você decidir fazer esse deploy.
service cloud.firestore {
  match /databases/{database}/documents {

    function ehAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('admin', false) == true;
    }

    // Texto de comentário, pergunta e resposta da página da instituição:
    // tamanho dentro do limite e sem link (os mesmos números de
    // webApp/assets/js/instituicao-util.js).
    function textoSemLink(texto, minimo, maximo) {
      return texto is string && texto.size() >= minimo && texto.size() <= maximo
        && !texto.matches('(?is).*(https?://|www[.]).*');
    }

    function nomeDoPerfil(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.get('nome', '');
    }

    // O certificado do Mural que dá direito a comentar, avaliar e responder
    // sobre uma unidade: a leitura achou a unidade no papel e conferiu o
    // nome da conta, e o curso e o ano gravados junto são os dele.
    function certificadoDaUnidade(uid, certificadoId, unidadeId, curso, ano) {
      let certificado = get(/databases/$(database)/documents/usuarios/$(uid)/certificados/$(certificadoId)).data;
      let verificacao = certificado.get('verificacao', {});
      return verificacao.get('unidadeLida', '') == unidadeId
        && verificacao.get('nomeConfere', false) == true
        && curso == certificado.get('titulo', '')
        && ano == certificado.get('anoConclusao', null);
    }

    // Cada aluno só pode ler/escrever o próprio documento de perfil.
    // O campo "admin" não pode ser alterado pelo próprio usuário via app —
    // só é promovido manualmente no Console do Firebase (Admin SDK ignora
    // estas regras) ou por quem já é admin. Isso evita autopromoção.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.get('admin', false) == false;
      allow update: if request.auth != null && request.auth.uid == uid &&
        (request.resource.data.get('admin', false) == resource.data.get('admin', false) || ehAdmin());
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Conteúdo dos Termos de Uso e Política de Privacidade, editável pelo
    // admin em admin-termos.html. "versao" sobe a cada publicação; é isso
    // que faz o gate-termos.js pedir novo aceite de quem já tinha aceitado
    // uma versão anterior. Aqui também ficam as capas dos eixos (capas) e
    // as notícias do carrossel da Início (destaques_inicio), escolhidas no
    // painel Admin · Notícias.
    match /configuracoes/{documentoId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Unidades (Etec, Fatec ou outra instituição) cadastradas pelo CMS:
    // leitura pública (usadas pelo app e futuramente pelo chatbot), escrita
    // restrita a administradores. A foto da fachada (foto, paginaCps) também
    // é gravada pelo admin, no botão "Buscar fotos no site do CPS".
    match /instituicoes/{unidadeId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Comentário e nota de quem estudou na unidade (instituicao.html): um
    // por conta, com o id igual ao uid. Todo mundo lê; grava só quem tem o
    // certificado da unidade no Mural, com o nome do perfil e o curso e o
    // ano do certificado. Apaga quem escreveu ou o admin.
    match /instituicoes/{unidadeId}/comentarios/{uid} {
      function comentarioValido() {
        let dados = request.resource.data;
        return dados.nota is int && dados.nota >= 1 && dados.nota <= 5
          && textoSemLink(dados.texto, 10, 600)
          && dados.certificadoId is string
          && dados.nome == nomeDoPerfil(uid)
          && certificadoDaUnidade(uid, dados.certificadoId, unidadeId, dados.curso, dados.ano);
      }

      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['texto', 'nota', 'nome', 'curso', 'ano', 'certificadoId', 'criadoEm'])
        && request.resource.data.criadoEm == request.time
        && comentarioValido();
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['texto', 'nota', 'nome', 'curso', 'ano', 'certificadoId', 'criadoEm', 'editadoEm'])
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.editadoEm == request.time
        && comentarioValido();
      allow delete: if request.auth != null && (request.auth.uid == uid || ehAdmin());
    }

    // Dúvidas sobre a unidade: qualquer conta com e-mail confirmado pergunta,
    // com o nome do perfil. As respostas ficam no próprio documento, uma por
    // conta (respostas.{uid}): responde quem tem o certificado da unidade,
    // com o curso e o ano dele, ou o admin, como "Equipe Futuro+". Cada conta
    // só mexe na própria resposta; o admin também apaga as dos outros. A
    // pergunta sai pelo admin, ou por quem perguntou enquanto ninguém respondeu.
    match /instituicoes/{unidadeId}/perguntas/{perguntaId} {
      function respostaValida(resposta) {
        let uid = request.auth.uid;
        return resposta.keys().hasOnly(['texto', 'nome', 'curso', 'ano', 'certificadoId', 'equipe', 'em'])
          && textoSemLink(resposta.texto, 5, 600)
          && resposta.em == request.time
          && resposta.nome == nomeDoPerfil(uid)
          && (
            (resposta.equipe == true && ehAdmin() && !('certificadoId' in resposta))
            || (resposta.equipe == false && resposta.certificadoId is string
              && certificadoDaUnidade(uid, resposta.certificadoId, unidadeId, resposta.curso, resposta.ano))
          );
      }

      function mexeuSoNaPropria() {
        let uid = request.auth.uid;
        let depois = request.resource.data.respostas;
        return depois.diff(resource.data.respostas).affectedKeys().hasOnly([uid])
          && (!(uid in depois) || respostaValida(depois[uid]));
      }

      function adminSoApagou() {
        let mudou = request.resource.data.respostas.diff(resource.data.respostas);
        return ehAdmin() && mudou.addedKeys().size() == 0 && mudou.changedKeys().size() == 0;
      }

      allow read: if true;
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['texto', 'autorUid', 'nome', 'criadaEm', 'respostas'])
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.criadaEm == request.time
        && request.resource.data.respostas == {}
        && request.resource.data.nome == nomeDoPerfil(request.auth.uid)
        && textoSemLink(request.resource.data.texto, 10, 300);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respostas'])
        && (mexeuSoNaPropria() || adminSoApagou());
      allow delete: if request.auth != null
        && (ehAdmin() || (resource.data.autorUid == request.auth.uid && resource.data.respostas.size() == 0));
    }

    // Certificados do mural: cada aluno mexe só nos próprios. Documento
    // pessoal, então nem outros alunos nem o app leem sem ser o dono.
    match /usuarios/{uid}/certificados/{certificadoId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Catálogo de cursos (descrição, duração, pré-requisitos): mesma regra das
    // unidades — todo mundo lê, só administrador escreve.
    match /cursos/{cursoId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // O histórico do chatbot só é lido/escrito pelo backend (Admin SDK),
    // que ignora estas regras. Bloqueado para qualquer acesso direto do app.
    match /chat_sessions/{sessionId} {
      allow read, write: if false;
    }

    // Demanda do vestibular, por unidade e semestre: só a função
    // coletar_demanda (Admin SDK) lê e escreve aqui. O que o site mostra é o
    // resumo por curso, que a função grava em cursos/{id}.demanda.
    match /demanda/{documento=**} {
      allow read, write: if false;
    }

    // Avisos que o admin manda (modal ao entrar e/ou sino no topo). Cada
    // notificação escolhe o público (conta, visitante ou todo mundo), então a
    // leitura é pública como o resto do conteúdo institucional — só admin
    // cria, edita ou apaga.
    match /notificacoes/{notificacaoId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Histórico do painel Admin · Notificações (quem criou, editou ou
    // excluiu cada aviso). Mesma regra do histórico das notícias próprias:
    // só cresce, com o e-mail e o uid de quem está logado e a hora do
    // servidor; ninguém edita nem apaga.
    match /notificacoes_historico/{registroId} {
      allow read: if ehAdmin();
      allow create: if ehAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.em == request.time;
      allow update, delete: if false;
    }

    // Tokens de notificação push (FCM), registrados por
    // notificacoes-push.js. Visitante sem conta também pode ativar, então
    // qualquer um pode criar/atualizar o próprio — mas só com "uid" vazio
    // (visitante) ou igual ao próprio uid, nunca o de outra pessoa (senão
    // daria pra "roubar" o alvo de uma notificação só de conta). Ninguém lê
    // pelo app: só a função enviar_push_da_notificacao (Admin SDK, ignora
    // estas regras) usa isso pra mandar o push.
    match /fcm_tokens/{token} {
      allow read: if false;
      allow write: if request.resource.data.uid == null ||
        (request.auth != null && request.resource.data.uid == request.auth.uid);
    }

    // Notícias de Etecs e Fatecs. O site só lê "noticias", que guarda apenas
    // o que um administrador aprovou no painel Admin · Notícias.
    match /noticias/{noticiaId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Tudo o que a coleta automática trouxe (pendente, aprovada ou
    // recusada). Quem inclui é a função coletar_noticias (Admin SDK); o
    // administrador lê e muda o status pelo painel. Visitante não lê.
    match /noticias_fila/{noticiaId} {
      allow read, write: if ehAdmin();
    }

    // Histórico do painel Admin · Notícias (aprovou, recusou, tirou do site,
    // editou...). Mesma regra do histórico das notícias próprias. A busca e a
    // limpeza feitas pelo servidor gravam pelo Admin SDK, que não passa por
    // aqui.
    match /noticias_historico/{registroId} {
      allow read: if ehAdmin();
      allow create: if ehAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.em == request.time;
      allow update, delete: if false;
    }

    // Resumo da última coleta, mostrado no painel. Só a função grava.
    match /noticias_coleta/{documento} {
      allow read: if ehAdmin();
      allow write: if false;
    }

    // Notícias escritas pelo próprio Futuro+ (painel Admin · Notícias
    // próprias). Aqui fica tudo, inclusive rascunho e agendada. O site só lê
    // a cópia que vai para "noticias" quando ela é publicada ou agendada.
    match /noticias_proprias/{noticiaId} {
      allow read, write: if ehAdmin();
    }

    // Histórico de quem fez o quê nas notícias próprias. Só cresce: ninguém
    // edita nem apaga, e cada registro precisa levar o e-mail e o uid de quem
    // está logado e a hora do servidor (não dá para registrar em nome de
    // outra pessoa nem com outra data). Fica mesmo depois que a notícia é
    // excluída.
    match /noticias_proprias_historico/{registroId} {
      allow read: if ehAdmin();
      allow create: if ehAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.em == request.time;
      allow update, delete: if false;
    }
  }
}
