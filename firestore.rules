rules_version = '2';

// Regras usadas apenas pelo emulador local do Firestore, para testar o
// chatbot na sua máquina. NÃO são publicadas automaticamente: só valem na
// nuvem se você rodar "firebase deploy --only firestore" de propósito.
// Se o projeto já tem regras configuradas no Console do Firebase, elas
// continuam intactas até você decidir fazer esse deploy.
service cloud.firestore {
  match /databases/{database}/documents {

    function ehAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('admin', false) == true;
    }

    // Cada aluno só pode ler/escrever o próprio documento de perfil.
    // O campo "admin" não pode ser alterado pelo próprio usuário via app —
    // só é promovido manualmente no Console do Firebase (Admin SDK ignora
    // estas regras) ou por quem já é admin. Isso evita autopromoção.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.get('admin', false) == false;
      allow update: if request.auth != null && request.auth.uid == uid &&
        (request.resource.data.get('admin', false) == resource.data.get('admin', false) || ehAdmin());
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Um CPF, uma conta: reservado no mesmo lote que cria o perfil (veja
    // cadastro.js), então duas contas não conseguem "ganhar a corrida" com o
    // mesmo CPF. Guarda só o uid do dono — leitura pública apenas confirma
    // se já tem dono, igual ao que a própria Auth do Firebase já expõe
    // quando um e-mail já está cadastrado. A liberação do CPF na exclusão de
    // conta é feita pelo Admin SDK (função agendada em functions/main.py),
    // que ignora estas regras — por isso não existe "allow delete" aqui.
    match /cpfs_em_uso/{cpf} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'criadoEm'])
        && !exists(/databases/$(database)/documents/cpfs_em_uso/$(cpf));
      allow update, delete: if false;
    }

    // Conteúdo dos Termos de Uso e Política de Privacidade, editável pelo
    // admin em admin-termos.html. "versao" sobe a cada publicação; é isso
    // que faz o gate-termos.js pedir novo aceite de quem já tinha aceitado
    // uma versão anterior.
    match /configuracoes/{documentoId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Unidades (Etec, Fatec ou outra instituição) cadastradas pelo CMS:
    // leitura pública (usadas pelo app e futuramente pelo chatbot), escrita
    // restrita a administradores.
    match /instituicoes/{unidadeId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Certificados do mural: cada aluno mexe só nos próprios. Documento
    // pessoal, então nem outros alunos nem o app leem sem ser o dono.
    match /usuarios/{uid}/certificados/{certificadoId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Catálogo de cursos (descrição, duração, pré-requisitos): mesma regra das
    // unidades — todo mundo lê, só administrador escreve.
    match /cursos/{cursoId} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // O histórico do chatbot só é lido/escrito pelo backend (Admin SDK),
    // que ignora estas regras. Bloqueado para qualquer acesso direto do app.
    match /chat_sessions/{sessionId} {
      allow read, write: if false;
    }
  }
}
